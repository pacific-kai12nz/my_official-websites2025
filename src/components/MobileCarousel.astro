---
const { lang = 'ja' } = Astro.props;
const work2Src = lang === 'en' ? '/images/create-banner-en.jpeg' : '/images/create-banner-jp.jpeg';
const work2Link = lang === 'en' ? '/en/topicks2' : '/topicks2';
---

<div class="swiper">
  <div class="swiper-wrapper">
    <!-- Slideにリンクを追加 -->
    <div class="swiper-slide">
      <a href="/topicks">
        <img src="/images/topicks1.png" alt="Slide 1" />
      </a>
    </div>
    <div class="swiper-slide">
      <a href={work2Link}>
        <img src={work2Src} alt="Slide 2" />
      </a>
    </div>
    <div class="swiper-slide">
      <a href={lang === 'en' ? '/en/topicks3' : '/topicks3'}>
        <img src="/images/topicks3.png" alt="Slide 3" />
      </a>
    </div>
    <div class="swiper-slide">
      <a href="/works/work4">
        <img src="/images/comigsoon.jpg" alt="Slide 4" />
      </a>
    </div>
  </div>

  <div class="swiper-pagination"></div>
  <div class="swiper-scrollbar"></div>
</div>

<style>
  .swiper-wrapper {
    max-width: 200px;
    max-height: 500px;
    text-align: center;
  }

  .swiper-slide img {
    height: 200px;
    max-width: 100%;
    object-fit: cover;
  }

  a {
    display: inline-block;
    width: 100%;
    height: 100%;
  }

  .swiper-button::after {
    font-size: 32px;
    color: rgb(215, 119, 22);
  }
</style>

<script>
import Swiper from 'swiper'
import { Pagination, Autoplay } from 'swiper/modules'
import 'swiper/css/bundle'

export const swiperConfig = {
  modules: [Pagination, Autoplay],
  loop: true,
  autoplay: {
    delay: 2000,
    disableOnInteraction: false,
  },
  pagination: {
    el: '.swiper-pagination',
    clickable: true,
  },
}

const swiper = new Swiper('.swiper', swiperConfig)
</script>
