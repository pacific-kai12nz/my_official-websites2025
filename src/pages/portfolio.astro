---
/* astro:async */
import "../styles/global.css";
import Header from "../layouts/Header.astro";
import Footer from "../layouts/Footer.astro";
import SocialIcons from "../components/SocialIcons.astro";
import SocialIcons2 from "../components/SocialIcons2.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faTwitter } from "@fortawesome/free-brands-svg-icons";
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import LanguageToggle from "../components/LanguageToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WORKS</title>
    <link rel="stylesheet" href="../styles/global.css">
</head>
<body>
    <Header></Header>
    <LanguageToggle />
    <main>
        <section id="title">
            <h1 class="page-title">WORKS</h1>
        </section>

        <section id="works">
            <h2 class="animated-text">UI/UX DESIGN</h2>
            <button class="view-all" onclick="window.location.href='https://www.vivivit.com/kainakamura'">View All</button>
        </section>
        
        <section id="works">
            <h2 class="animated-text">GRAPHIC DESIGN</h2>
            <button class="view-all" onclick="window.location.href='https://www.foriio.com/kainakamura-graphicdesigner'">View All</button>
        </section>
        
        <section id="works">
            <h2 class="animated-text">VIDEO CREATION</h2>
            <button class="view-all" onclick="window.location.href='https://lit.link/PacificKai12'">View All</button>
        </section>
        
        <section id="works">
            <h2 class="animated-text">Coming Soon</h2>
            <button class="view-all">View All</button>
        </section>
        
        <section id="works">
            <h2 class="animated-text">SNS</h2>
            <div class="button-container2">
                <button class="view-all" onclick="window.location.href='https://www.instagram.com/kaipora_12nz'">Photography</button>
                <button class="view-all" onclick="window.location.href='https://www.instagram.com/kaipora_12nz'">Illustration</button>
            </div>
        </section>
    </main>
        <SocialIcons2 />

    <FontAwesomeIcon icon={faTwitter} size="2x" className="twitter-icon" client:load />
    <Footer></Footer>
</body>
</html>


<style>
body {
    font-family: 'Oswald', sans-serif;
    background-color: white;
    color: black;
    text-align: center;
}
.page-title {
    text-align: center;
    font-size: 50px;
    padding: 60px 0;
    margin-top: 50px;
}
#works {
    margin-bottom: 50px;
    margin: 0 auto 50px auto;
    text-align: center;
    max-width: 800px;
    padding: 0 20px;
    position: relative;
}
#works h2 {
    font-size: 50px;
    margin-bottom: 20px;
    text-align: center;
}
.view-all {
    display: block;
    width: 150px;
    margin: 10px auto; 
    padding: 10px;
    font-size: 16px;
    color: white;
    background: linear-gradient(to right, lightblue, lightcoral);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-align: center; 
}
.button-container {
    display: flex;
    gap: 20px;
    justify-content: center;
}
.button-container2 {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}
/* ホバー時のアニメーション */
.view-all:hover {
    transform: scale(1.1); 
    background: linear-gradient(to right, lightcoral, lightblue);
}
/* クリック時のアニメーション */
.view-all:active {
    transform: scale(0.9); /* 押したときに少し縮む */
    opacity: 0.8; /* 少し透明になる */
}

/* タイピング風 */
.animated-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 3px solid white;
    width: 0;
    animation: typing 2s steps(20, end) forwards, blink 0.75s step-end infinite;
}

@keyframes typing {
    0% { width: 0; }
    50% { width: 100%; }
    100% { width: 0; }
}

@keyframes blink {
    50% { border-color: transparent; }
}

.animated-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 3px solid white;
    width: 0;
    animation: typing 3s steps(20, end) infinite, blink 0.75s step-end infinite;
}

.twitter-icon {
    color: white;
    display: none;
}

/* スマホ表示時のみ（〜480px以下） */
@media screen and (max-width: 480px) {
    .page-title{
        font-size: 40px;
    }
    #works {
        margin: 0 auto;
        text-align: center;
        padding: 0 10px;
    }

    #works h2 {
        font-size: 30px;
        margin-bottom: 15px;
    }

    .view-all {
        margin: 10px auto;
    }

    .button-container {
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }
    .button-container2{
        margin-bottom: 50px;
    }
}

/* ソーシャルアイコンの表示制御 */
.social-icons-pc {
    display: block;
}

.social-icons-mobile {
    display: none;
}

/* portfolioページ専用のソーシャルアイコン色設定 */
.social-icons-pc .social-icons a,
.social-icons-mobile .social-icons a {
    color: black !important;
}

@media screen and (max-width: 768px) {
    .social-icons-pc {
        display: none;
    }
    
    .social-icons-mobile {
        display: block;
    }
}

</style>