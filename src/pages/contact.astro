---
import "../styles/global.css";
import Header from "../layouts/Header.astro";
import Footer from "../layouts/Footer.astro";
import SocialIcons from "../components/SocialIcons.astro";
import SocialIcons2 from "../components/SocialIcons2.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faTwitter } from "@fortawesome/free-brands-svg-icons";
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import LanguageToggle from "../components/LanguageToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CONTACT</title>
    <link rel="stylesheet" href="../styles/global.css">
</head>

<body>
    <Header></Header>
    <main>
        <section id="title">
            <h1 class="page-title">CONTACT</h1>
        </section>

        <section id="contact-form">
            <form action="https://formsubmit.co/fd4a92181a93e8b4f07be82e3a25ed59" method="POST" class="contact-form">
                <div class="form-group">
                    <label for="name">お名前 <span class="required">*</span></label>
                    <input type="text" id="name" name="name" required placeholder="山田 太郎">
                </div>

                <div class="form-group">
                    <label for="email">メールアドレス <span class="required">*</span></label>
                    <input type="email" id="email" name="email" required placeholder="example@email.com">
                </div>

                <div class="form-group">
                    <label for="subject">件名</label>
                    <input type="text" id="subject" name="subject" placeholder="お問い合わせの件名">
                </div>

                <div class="form-group">
                    <label for="message">メッセージ <span class="required">*</span></label>
                    <textarea id="message" name="message" rows="6" required placeholder="お問い合わせ内容をご記入ください"></textarea>
                </div>

                <input type="hidden" name="_subject" value="ウェブサイトからのお問い合わせ">
                <input type="hidden" name="_captcha" value="false">

                <button type="submit" class="submit-btn">送信する</button>
            </form>
        </section>
    </main>
        <SocialIcons2 />

    <Footer></Footer>
    <FontAwesomeIcon icon={faTwitter} size="2x" className="twitter-icon" client:load />
</body>
</html>


<style>
body {
    font-family: 'Oswald', sans-serif;
    background-color: white;
    color: black;
    text-align: center;
}

/* Title */
.page-title {
    text-align: center;
    font-size: 50px;
    padding: 60px 0;
    margin-top: 50px;
}

/* Contact Form */
#contact-form {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px 40px 60px;
}

.contact-form {
    text-align: left;
}

.form-group {
    margin-bottom: 24px;
}

.form-group label {
    display: block;
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 8px;
    color: #333;
}

.required {
    color: #e74c3c;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px 16px;
    font-size: 16px;
    font-family: 'Oswald', sans-serif;
    border: 2px solid #ddd;
    border-radius: 8px;
    box-sizing: border-box;
    transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: lightcoral;
}

.form-group textarea {
    resize: vertical;
    min-height: 120px;
}

.submit-btn {
    display: block;
    width: 100%;
    padding: 14px;
    font-size: 18px;
    font-family: 'Oswald', sans-serif;
    color: white;
    background: #000;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.3s ease;
    margin-top: 20px;
}

.submit-btn:hover {
    transform: scale(1.02);
    background: #333;
}

.submit-btn:active {
    transform: scale(0.98);
    opacity: 0.9;
}

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
}

main {
    flex: 1;
}

footer {
    background-color: black;
    text-align: center;
    color: white;
    font-size: 15px;
    font-family: 'Oswald', sans-serif;
    padding: 20px;
    width: 100%;
}

.twitter-icon {
    color: white;
    display: none;
}

/* ソーシャルアイコンの表示制御 */
.social-icons-pc {
    display: block;
}

.social-icons-mobile {
    display: none;
}

/* contactページ専用のソーシャルアイコン色設定 */
.social-icons-pc .social-icons a,
.social-icons-mobile .social-icons a {
    color: black !important;
}

@media screen and (max-width: 768px) {
    .social-icons-pc {
        display: none;
    }

    .social-icons-mobile {
        display: block;
    }
}
</style>
