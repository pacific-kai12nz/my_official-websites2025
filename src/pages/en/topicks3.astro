---
import "../../styles/global.css";
import Header from "../../layouts/Header.astro";
import Footer from "../../layouts/Footer.astro";
import SocialIcons from "../../components/SocialIcons.astro";
import SocialIcons2 from "../../components/SocialIcons2.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faTwitter } from "@fortawesome/free-brands-svg-icons";
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import LanguageToggle from "../../components/LanguageToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PICK UP TOPICKS</title>
  </head>

  <body>
    <Header />
    <LanguageToggle />
    <main>
      <section id="title">
        <h1 class="page-title">PICK UP TOPICKS</h1>
      </section>

      <div class="container">
        <div class="news-title"><em class="new-badge">NEW</em>
            We’ve launched Zerokuri and our freelance team Wondaston!</div>
        <div class="news-date">2025.06.30 NEWS</div>
        <img class="feature-image" src="/images/branding.jpg" alt="Feature Image" />
        <div class="news-content">
          <p>
            We’ve launched a new community called <strong>ZERO CREATION (Zerokuri)</strong> and formed a freelance team named <strong>Wondaston</strong>.<br />
  <em>“Don’t give up on your ‘I want to try.’ Even from zero, you can become a creator. Take your first step with Zerokuri.”</em><br />
  <strong>【Current Departments】</strong><br />
  Engineers<br />
  Designers<br />
  Video Creators<br />
  Photographers<br />
  And many other creative fields!<br />
  You’re free to challenge anything. Many of our members started with no experience! Dreams give power to your goals and Zerokuri is here to help make your dreams come true. It’s a community circle for people who want to bring their ideas to life. We also offer support to help you turn them into reality!<br />
  You can connect with creators not only in Japan, but all over the world! You’ll have opportunities to expand your network and build peer connections.<br />
  We’ll provide the space how you make the most of it is up to you!<br />
  If you’re serious and motivated, we’re waiting for you! We’re always looking for new members!<br />
          </p>
          <br />
          <p>
            ■Official Instagram<br />
            <a href="https://www.instagram.com/01zero.creation" class="animated-button">Click here</a>
          </p>
          <p>
            ■Official X<br />
            <a href="https://x.com/01_zerocreation" class="animated-button">Click here</a>
          </p>
        </div>
      </div>
    </main>
        <SocialIcons2 />
    <Footer />
    <FontAwesomeIcon icon={faTwitter} size="2x" className="twitter-icon" client:load />
  </body>
</html>

<style>

body {
    font-family: 'Oswald', sans-serif;
    background: linear-gradient(#f5f0f6, #f9f5f7);
    color: #333;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

main {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.container {
    max-width: 800px;
    width: 100%;
    padding: 40px;
}

.news-title {
    font-size: 24px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 10px;
    margin-bottom: 20px;
    margin-top: 40px;
}

.new-badge {
    background: linear-gradient(45deg, #ff4757, #ff3742);
    color: white;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    margin-left: 10px;
    box-shadow: 0 2px 8px rgba(255, 71, 87, 0.3);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% {
        transform: scale(1);
        box-shadow: 0 2px 8px rgba(255, 71, 87, 0.3);
    }
    50% {
        transform: scale(1.05);
        box-shadow: 0 4px 16px rgba(255, 71, 87, 0.5);
    }
    100% {
        transform: scale(1);
        box-shadow: 0 2px 8px rgba(255, 71, 87, 0.3);
    }
}

.news-date {
    font-size: 14px;
    color: #888;
    margin-bottom: 30px;
}

img.feature-image {
    width: 100%;
    border-radius: 5px;
    margin-bottom: 20px;
}

.news-content {
    line-height: 1.8;
}

.link-section a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.link-section a:hover {
    text-decoration: underline;
}

.animated-button {
  display: inline-block;
  margin: 10px 0;
  padding: 10px 20px;
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
  text-decoration: none;
  border-radius: 25px;
  background: linear-gradient(to right, lightcoral, lightblue);
  background-size: 200% auto;
  transition: 0.5s;
  box-shadow: 0 4px 8px rgba(0,0,0,0.3);
}

.animated-button:hover {
  background-position: right center;
  transform: scale(1.05);
}


.twitter-icon {
    color: white;
    display: none;
}


@media screen and (max-width: 768px) {
    .social-icons-pc {
        display: none;
    }
    
    .social-icons-mobile {
        display: block;
    }
}

</style>