---
import "../../styles/global.css";
import Header from "../../layouts/Header.astro";
import Footer from "../../layouts/Footer.astro";
import SocialIcons from "../../components/SocialIcons.astro";
import SocialIcons2 from "../../components/SocialIcons2.astro";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faTwitter } from "@fortawesome/free-brands-svg-icons";
import { getLangFromUrl, useTranslations } from '../../i18n/ui';
import LanguageToggle from "../../components/LanguageToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MENU</title>
    <link rel="stylesheet" href="../../styles/global.css">
</head>

<body>
    <Header></Header>
    <LanguageToggle />
    <main>
        <section id="title">
            <h1 class="page-title">MENU</h1>
        </section>

        <section id="works">
            <!-- 今後、メニュー内容が増えた時はここに追加 -->
             <h1 class="page-subtitle">COMING SOON</h1>
        </section>
    </main>
        <SocialIcons2 />

    <Footer></Footer>
    <FontAwesomeIcon icon={faTwitter} size="2x" className="twitter-icon" client:load />
</body>
</html>

<style>
body {
    font-family: 'Oswald', sans-serif;
    background-color: white;
    color: black;
    text-align: center;
}
.page-title {
    text-align: center;
    font-size: 50px;
    padding: 60px 0;
    margin-top: 50px;
}

.page-subtitle {
    text-align: center;
    font-size: 50px;
    padding: 60px 0;
    margin-top: 50px;
}
#works {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: 60vh;
}
#works h2 {
    font-size: 50px;
    margin-bottom: 20px; 
}
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
}
main {
    flex: 1;
}
footer {
    background-color: black;
    text-align: center;
    color: white;
    font-size: 15px;
    font-family: 'Oswald', sans-serif;
    padding: 20px;
    width: 100%;
}
.twitter-icon {
    color: white;
    display: none;
}

/* ソーシャルアイコンの表示制御 */
.social-icons-pc {
    display: block;
}

.social-icons-mobile {
    display: none;
}

/* menuページ専用のソーシャルアイコン色設定 */
.social-icons-pc .social-icons a,
.social-icons-mobile .social-icons a {
    color: black !important;
}

@media screen and (max-width: 768px) {
    .social-icons-pc {
        display: none;
    }
    
    .social-icons-mobile {
        display: block;
    }
}
</style>
