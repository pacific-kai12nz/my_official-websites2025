<style is:global>
html, body {
  background: #0a0a0a !important;
}
</style>

<style>
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  font-family: 'Oswald', 'Helvetica Neue', sans-serif;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page {
  width: 100%;
  max-width: 430px;
  margin: 0 auto;
  min-height: 100vh;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding-top: 90px;
  padding-bottom: 60px;
}

@media screen and (max-width: 480px) {
  .page { padding-top: 70px; }
}

/* ===== Hero ===== */
.hero {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  flex-shrink: 0;
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 35%,
    rgba(10, 10, 10, 0.55) 65%,
    #0a0a0a 100%
  );
}

.hero-text {
  position: absolute;
  bottom: 28px;
  left: 0;
  right: 0;
  text-align: center;
  padding: 0 20px;
}

.hero-name {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 6px;
}

.hero-sub {
  font-size: 13px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.65);
  letter-spacing: 0.06em;
}

/* ===== SNS Icons ===== */
.sns-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
  padding: 24px 20px;
}

.sns-row a {
  color: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: color 0.2s, transform 0.15s;
}

.sns-row a:hover {
  color: #fff;
  transform: scale(1.12);
}

.sns-row svg {
  width: 22px;
  height: 22px;
}

/* ===== Buttons ===== */
.links {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 0 16px;
}

.btn {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 60px;
  padding: 0 20px;
  background: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 10px;
  color: rgba(255, 255, 255, 0.88);
  font-family: 'Oswald', sans-serif;
  font-size: 15px;
  font-weight: 500;
  text-decoration: none;
  letter-spacing: 0.04em;
  line-height: 1;
  transition: background 0.2s, transform 0.15s;
  gap: 14px;
}

.btn:hover {
  background: #222222;
  transform: translateY(-1px);
}

.btn-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.btn-logo svg {
  width: 28px;
  height: 28px;
}

.apple-podcast-logo {
  color: #b150e2;
}

.btn-text {
  flex: 1;
  text-align: center;
  padding-right: 32px;
}

/* ===== Back link ===== */
.back-link {
  display: block;
  text-align: center;
  margin-top: 32px;
  font-size: 12px;
  color: #fff;
  text-decoration: none;
  letter-spacing: 0.06em;
  transition: color 0.2s;
}

.back-link:hover {
  color: rgba(255, 255, 255, 0.7);
}
</style>
