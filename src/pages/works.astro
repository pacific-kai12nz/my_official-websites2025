<style>
body {
    font-family: 'Oswald', sans-serif;
    background: white;
    color: #333;
    text-align: center;
    min-height: 100vh;
    position: relative;
}

.page-title {
    text-align: center;
    font-size: 50px;
    padding: 60px 0 30px 0;
    margin-top: 50px;
    color: #333;
    text-shadow: none;
}

/* Tab Navigation Styles - Browser Tab Design */
.tab-navigation {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 40px auto 60px;
    max-width: 900px;
    padding: 0 20px;
}

.tab-button {
    padding: 16px 35px;
    font-size: 17px;
    font-weight: 600;
    font-family: 'Oswald', sans-serif;
    background: #e8e8e8;
    color: #666;
    border: none;
    border-radius: 12px 12px 0 0;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.tab-button:hover {
    background: #d5d5d5;
    color: #333;
    transform: translateY(-2px);
}

.tab-button.active {
    background: white;
    color: #333;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.1);
    border-bottom: 3px solid #ff6b6b;
}

.tab-button.active::before {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #ff6b6b 0%, #ffa726 100%);
}

/* Tab Content Styles */
.tab-content {
    display: none;
    animation: fadeIn 0.5s ease;
}

.tab-content.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.works-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
}

.project-card {
    margin-bottom: 80px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 60px;
    color: #333;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
}

.project-visual {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-shrink: 0;
    width: auto;
}

.project-image {
    width: 400px;
    height: 400px;
    object-fit: cover;
    border-radius: 10px;
}

.device-mockup {
    position: relative;
}

.device-mockup.laptop {
    width: 300px;
    height: 200px;
}

.device-mockup.mobile {
    width: 120px;
    height: 200px;
}

.screen {
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 10px;
    padding: 15px;
    box-sizing: border-box;
}

.website-preview {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border-radius: 5px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    text-align: center;
}

.website-preview.tourism {
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    position: relative;
    overflow: hidden;
}

.website-preview.tourism::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(90deg, #333 0%, #666 50%, #333 100%);
    clip-path: polygon(0 100%, 100% 100%, 100% 0, 0 0);
}

.website-preview.personal-color {
    background: linear-gradient(135deg, #ff6b6b 0%, #4ecdc4 100%);
}

.website-header h3 {
    font-size: 14px;
    margin: 0 0 5px 0;
    font-weight: bold;
}

.dates {
    font-size: 12px;
    margin: 0;
    opacity: 0.8;
}

.color-people {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.person {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(45deg, #ff6b6b, #4ecdc4);
